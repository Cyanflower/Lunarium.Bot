<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lunarium.Bot.SearchBot</RootNamespace>
    <OutputPath>$(SolutionDir)dist\$(MSBuildProjectName)\</OutputPath>
    <UserSecretsId>e3bcbee0-3d4e-46b7-a0dc-4a3d59e919a0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Discord.Net" Version="3.18.0" />
    <PackageReference Include="JiebaNet.Segmenter" Version="1.0.6" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.7" />
    <PackageReference Include="Nanoid" Version="3.1.0" />
    <PackageReference Include="Npgsql" Version="9.0.4" />
    <PackageReference Include="Polly" Version="8.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 引用共享库 -->
    <ProjectReference Include="../Lunarium.Bot.Scheduler/Lunarium.Bot.Scheduler.csproj" />
    <ProjectReference Include="..\Lunarium.Bot.Logger\Lunarium.Bot.Logger.csproj" />
    <ProjectReference Include="..\Lunarium.Bot.Extensions\Lunarium.Bot.Extensions.csproj" />
  </ItemGroup>
</Project>

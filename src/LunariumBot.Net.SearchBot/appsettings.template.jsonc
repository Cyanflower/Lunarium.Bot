{
  "DatabaseConnection": "Host=...;Port=...;Username...;Password=...;Database=...;Include Error Detail=true;Client Encoding=UTF8;",
  // 管理员鉴权配置
  "AuthConfig": {
    "AdminRoleIds": [
      123
    ],
    "LogChannel": 123,
    "LogThread": 123
  },
  // 服务器配置(支持多服务器部署)
  "DeployConfig": {
    // 部署的服务器ID列表（用于数据采集）
    "DeployGuildIds": [
      123
    ],

    // 按服务器组织的数据分析配置
    "GuildAnalysisConfigs": {
      // 服务器 ID: 123 (主服务器)
      "123": {
        // 该服务器的 Dashboard 频道（接收数据分析报告）
        "DashboardChannelId": 123,
        // 该服务器的频道分类映射
        "CategoryChannels": {
          "abc": 123
        }
      }
      // 如果有第二个服务器，可以这样添加：
      // "123": {
      //   "DashboardChannelId": 123,
      //   "CategoryChannels": {
      //     "测试分类": 123
      //   }
      // }
    },

    "ExcludeChannelIds": [],
    "ExcludeCategoryIds": [],
    // 只影响扫描的数据获取，不影响命令鉴权
    "ExcludeGuildIds": [],
    // 扫描配置
    "ScanConfigs":
    {
      // 服务器ID
      "123": {
        // 控制数据库 is_valid 字段的 true 和 false
        // 在扫描时哪些频道的帖子视为 is_valid true
        "ValidChannels":{
          "abc": 123
        }
      }
      // 如果有第二个服务器，可以这样添加：
      // "123": {
      //   "ValidChannel": {
      //     "测试分类": 123
      //   }
      // }
    }
  },
  "ChannelOrder": {
    "abc": 1
  }
}
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- 同时决定发布出的可执行文件名 -->
    <AssemblyName>Lunarium.Bot.Ticket</AssemblyName>

    <!--
      发布外观：
      服务器（linux-x64）不安装 .NET 运行时，所以 Release 默认按自包含单文件发布，
      `dotnet publish -c Release` 即可直接产出可上传的二进制。
      Debug / IDE 构建保持框架依赖，便于本地调试。
    -->
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">linux-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>

    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- 单文件发布不启用裁剪：Discord.Net / STJ 依赖反射，裁剪会到运行时才暴露问题 -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- 不生成 pdb / xml 文档，减小发布体积 -->
    <DebugType Condition="'$(Configuration)' == 'Release'">None</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <!-- 连引用项目的 pdb / xml 也不复制，保持发布目录只剩二进制与模板 -->
    <AllowedReferenceRelatedFileExtensions Condition="'$(Configuration)' == 'Release'">.none</AllowedReferenceRelatedFileExtensions>
    <CopyOutputSymbolsToOutputDirectory Condition="'$(Configuration)' == 'Release'">false</CopyOutputSymbolsToOutputDirectory>

    <!-- 固定发布目录：src/Lunarium.Bot.Ticket/dist/（已被 .gitignore 忽略） -->
    <PublishDir>dist\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- 引用共享库 -->
    <ProjectReference Include="../../Discord.Net/src/Discord.Net.Core/Discord.Net.Core.csproj" />
    <ProjectReference Include="../../Discord.Net/src/Discord.Net.Interactions/Discord.Net.Interactions.csproj" />
    <ProjectReference Include="../../Discord.Net/src/Discord.Net.Rest/Discord.Net.Rest.csproj" />
    <ProjectReference Include="../../Discord.Net/src/Discord.Net.WebSocket/Discord.Net.WebSocket.csproj" />
    <ProjectReference Include="../Lunarium.Bot.Framework/Lunarium.Bot.Framework.csproj" />
    <ProjectReference Include="../Lunarium.Bot.AI/Lunarium.Bot.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CopyToOutputDirectory 让编译器在构建时复制它们 -->
    <!-- CopyToPublishDirectory 让它们出现在发布目录里 -->
    <!-- ExcludeFromSingleFile 避免被嵌进单文件二进制 -->
    <!-- PreserveNewest: 如果文件没变动就不复制 -->
    <Content Include="appsettings.template.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="appsettings.health.template.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lunarium.Common" Version="1.4.0" />
    <PackageReference Include="Lunarium.Logging" Version="1.1.0" />
    <PackageReference Include="Lunarium.Logging.Hosting" Version="1.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Polly" Version="8.8.0" />
    <!-- 归档打包时把 PNG 转成高质量 JPEG（只处理内存，不改磁盘原件） -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

</Project>

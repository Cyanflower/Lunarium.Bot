<Project Sdk="Microsoft.NET.Sdk">

  <!--
    发布形态（Release 自包含单文件 / linux-x64 / 去 pdb·xml）统一由
    build/Bot.props 提供，此处不再重复声明。
  -->
  <Import Project="../../build/Bot.props" />

  <ItemGroup>
    <!-- 引用共享库 -->
    <ProjectReference Include="../../Discord.Net/src/Discord.Net.Core/Discord.Net.Core.csproj" />
    <ProjectReference Include="../../Discord.Net/src/Discord.Net.Interactions/Discord.Net.Interactions.csproj" />
    <ProjectReference Include="../../Discord.Net/src/Discord.Net.Rest/Discord.Net.Rest.csproj" />
    <ProjectReference Include="../../Discord.Net/src/Discord.Net.WebSocket/Discord.Net.WebSocket.csproj" />
    <ProjectReference Include="../Lunarium.Bot.Framework/Lunarium.Bot.Framework.csproj" />
    <ProjectReference Include="../Lunarium.Bot.AI/Lunarium.Bot.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CopyToOutputDirectory 让编译器在构建时复制它们 -->
    <!-- CopyToPublishDirectory 让它们出现在发布目录里 -->
    <!-- ExcludeFromSingleFile 避免被嵌进单文件二进制 -->
    <!-- PreserveNewest: 如果文件没变动就不复制 -->
    <Content Include="appsettings.template.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="appsettings.health.template.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lunarium.Common" Version="1.4.0" />
    <PackageReference Include="Lunarium.Logging" Version="1.1.0" />
    <PackageReference Include="Lunarium.Logging.Hosting" Version="1.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Polly" Version="8.8.0" />
    <!-- 归档打包时把 PNG 转成高质量 JPEG（只处理内存，不改磁盘原件） -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

</Project>

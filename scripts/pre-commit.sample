#!/bin/bash

# ============================================================================
# Git Pre-commit Hook - Token 安全检查（通用版 - 修复版）
# ============================================================================
# 
# 用途: 防止提交包含真实 Discord Bot Token 的任何文件
# 检查策略: 扫描所有待提交文件，检测 Discord Token 格式
# Token 格式: [Base64].[Base64].[Base64]
# 
# 安装方法:
#   1. 将此文件复制到 .git/hooks/pre-commit
#   2. chmod +x .git/hooks/pre-commit
# ============================================================================

echo "🔍 正在扫描所有文件以检测潜在的 Token 泄露..."

# Discord Token 正则表达式
# 格式: [24-28个字符的Base64].[6个字符的Base64].[27-40个字符的Base64]
TOKEN_PATTERN='[A-Za-z0-9_-]{24,28}\.[A-Za-z0-9_-]{6}\.[A-Za-z0-9_-]{27,40}'

# 获取所有待提交的文件
files=$(git diff --cached --name-only --diff-filter=ACM)

# 如果没有文件被修改，直接通过
if [ -z "$files" ]; then
    echo "✓ 未检测到文件变更"
    exit 0
fi

# 检查标志
has_error=0
total_files=0
scanned_files=0

# 检查文件是否为二进制文件的函数（不依赖 file 命令）
is_text_file() {
    local file="$1"
    
    # 方法1: 检查文件扩展名（常见文本文件）
    case "$file" in
        *.txt|*.md|*.json|*.xml|*.yaml|*.yml|*.js|*.ts|*.jsx|*.tsx|\
        *.py|*.rb|*.sh|*.bash|*.zsh|*.c|*.cpp|*.h|*.hpp|*.java|\
        *.go|*.rs|*.php|*.html|*.css|*.scss|*.sass|*.less|\
        *.sql|*.env|*.config|*.conf|*.ini|*.toml|*.gitignore|\
        *.dockerfile|Dockerfile|Makefile|*.cmake|*.gradle|*.properties|\
        *.vue|*.svelte|*.astro|.eslintrc*|.prettierrc*|package.json|tsconfig.json)
            return 0
            ;;
    esac
    
    # 方法2: 检查文件前100个字节是否包含 null 字节（二进制文件特征）
    if head -c 100 "$file" 2>/dev/null | grep -qI .; then
        return 0  # 是文本文件
    else
        return 1  # 可能是二进制文件
    fi
}

# 检查每个文件
while IFS= read -r file; do
    total_files=$((total_files + 1))
    
    # 跳过不存在的文件（已删除）
    if [ ! -f "$file" ]; then
        continue
    fi
    
    # 检查是否为文本文件
    if is_text_file "$file"; then
        scanned_files=$((scanned_files + 1))
        
        # 在文件中搜索 Token 模式
        matches=$(grep -nE "$TOKEN_PATTERN" "$file" 2>/dev/null || true)
        
        if [ -n "$matches" ]; then
            if [ $has_error -eq 0 ]; then
                echo ""
                echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                echo "❌ 警告: 检测到疑似 Discord Bot Token！"
                echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                echo ""
            fi
            
            echo "📁 文件: $file"
            echo ""
            
            # 显示每个匹配项（遮蔽中间部分）
            echo "$matches" | while IFS=: read -r line_num line_content; do
                # 提取 Token（可能有多个）
                tokens=$(echo "$line_content" | grep -oE "$TOKEN_PATTERN")
                
                echo "$tokens" | while IFS= read -r token; do
                    # 遮蔽 Token 中间部分（只显示前后各10个字符）
                    masked_token=$(echo "$token" | sed -E 's/^(.{10}).*(.{10})$/\1****\2/')
                    echo "   第 $line_num 行: 检测到 Token 格式 -> $masked_token"
                done
            done
            
            echo ""
            has_error=1
        fi
    fi
done <<< "$files"

# 显示扫描统计
echo "📊 扫描统计: 共检查 $scanned_files 个文本文件（总文件数: $total_files）"
echo ""

# 如果有错误，阻止提交
if [ $has_error -eq 1 ]; then
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "⛔ 提交被阻止！检测到疑似 Discord Bot Token"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "🔒 Token 格式说明:"
    echo "   Discord Bot Token 格式: [Base64].[Base64].[Base64]"
    echo "   示例: MTM4NDM...g (已遮蔽)"
    echo ""
    echo "✅ 解决方案："
    echo ""
    echo "  1. 移除真实 Token（推荐）:"
    echo "     - 将 Token 替换为占位符（如 \"YOUR_TOKEN_HERE\"）"
    echo "     - 或完全删除包含 Token 的行"
    echo ""
    echo "  2. 使用环境变量:"
    echo "     - 在代码中使用: process.env.DISCORD_TOKEN"
    echo "     - 在本地配置: export DISCORD_TOKEN=\"your_token\""
    echo ""
    echo "  3. 使用配置文件（添加到 .gitignore）:"
    echo "     - 创建 config.local.json 或 .env 文件"
    echo "     - 将文件添加到 .gitignore"
    echo ""
    echo "  4. 检查 .gitignore:"
    echo "     - 确保敏感文件已被忽略"
    echo "     - 常见文件: .env, config.local.*, *.secret.*"
    echo ""
    echo "  ⚠️  如果这是误报（如测试数据），可以："
    echo "     - 调整 Token 格式使其不匹配正则表达式"
    echo "     - 或使用 git commit --no-verify（极不推荐）"
    echo ""
    echo "  🔐 如果 Token 已泄露:"
    echo "     - 立即在 Discord Developer Portal 重置 Token"
    echo "     - 检查 Git 历史记录并清理"
    echo ""
    exit 1
fi

echo "✅ Token 安全检查通过 - 未发现疑似 Token"
exit 0
